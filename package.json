    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "chart.js": "^4.5.1",
    "naive-ui": "^2.45.3",
    "pinia": "^4.0.3",
    "pinyin-pro": "^3.29.3",
