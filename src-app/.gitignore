# Generated by Cargo
# will have compiled files and executables
/target/

# NSH CLI 生成物（nsh run/build/package 写入：runner 源码、describe、构建产物；
# 上游约定 .gitignore 含 .nsh/，见 nsh.dev project-structure）
/.nsh/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# Android 签名材料（issue #560 / ADR-0074 决策 3）：keystore 与口令文件永不入库
/gen/android/keystore.properties
/gen/android/*.jks

# Coverage reports (cargo llvm-cov)
/lcov.info
/coverage/
