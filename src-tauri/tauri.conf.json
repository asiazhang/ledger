{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenLedger",
  "version": "0.11.0",
  "identifier": "com.zhangheng.ledger",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenLedger",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 600,
        "backgroundColor": "#101014"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGOERFODc5M0E0NTVENjAKUldSZ1hVVTZlZWlOMzBkdDBYaU9Zc0QwNjh6Ky9sc25ZcmpyM3VuNkVLVWozbVZ5ZHlXd055bHQK",
      "endpoints": [
        "https://github.com/asiazhang/ledger/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application"
    }
  }
}
