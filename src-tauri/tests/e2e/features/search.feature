Feature: 交易搜索
  用户通过关键字检索交易：支持备注、转出账户名整词匹配、前缀通配与拼音首字母匹配，
  按相关度排序、服务端分页，覆盖全部交易类型与黑洞账户交易（口径与交易列表一致）。
  支持金额/日期筛选（issue #40）：金额区间（整数分，含边界，单边可用）、
  日期区间（YYYY-MM-DD 字符串比较，含边界），与关键字 AND 组合；
  无关键字仅筛选也可出结果。

  Scenario: 存量交易迁移后按备注整词搜索
    Given 存在账户 "现金" 类型 "cash" 币种 "CNY"
    And 存量交易 备注 "午餐外卖" 金额 1500 账户 "现金" 日期 "2026-02-01"
    And 存量交易 备注 "地铁通勤" 金额 300 账户 "现金" 日期 "2026-02-02"
    When 重建搜索索引
    When 搜索 "午餐"
    Then 搜索命中 1 条 总数 1
    And 搜索结果第 1 条备注应为 "午餐外卖"

  Scenario: 按账户名整词搜索
    Given 存在账户 "招商银行" 类型 "bank" 币种 "CNY"
    And 存在账户 "现金" 类型 "cash" 币种 "CNY"
    When 创建交易 类型 "income" 金额 5000 到账户 "招商银行" 日期 "2026-02-01"
    And 创建交易 类型 "expense" 金额 1500 到账户 "现金" 日期 "2026-02-02" 备注 "午餐"
    When 搜索 "招商"
    Then 搜索命中 1 条 总数 1
    And 搜索结果第 1 条金额应为 5000

  Scenario: 拼音首字母缩写命中
    Given 存在账户 "现金" 类型 "cash" 币种 "CNY"
    When 创建交易 类型 "expense" 金额 1500 到账户 "现金" 日期 "2026-02-01" 备注 "吃饭"
    When 搜索 "cf"
    Then 搜索命中 1 条 总数 1
    When 搜索 "zsyh"
    Then 搜索命中 0 条

  Scenario: 账户名拼音首字母命中
    Given 存在账户 "招商银行" 类型 "bank" 币种 "CNY"
    When 创建交易 类型 "income" 金额 5000 到账户 "招商银行" 日期 "2026-02-01"
    When 搜索 "zsyh"
    Then 搜索命中 1 条 总数 1

  Scenario: 前缀通配命中记得词首
    Given 存在账户 "现金" 类型 "cash" 币种 "CNY"
    When 创建交易 类型 "expense" 金额 1500 到账户 "现金" 日期 "2026-02-01" 备注 "吃饭"
    When 搜索 "吃"
    Then 搜索命中 1 条 总数 1

  Scenario: 新建交易后立即可搜
    Given 存在账户 "现金" 类型 "cash" 币种 "CNY"
    When 创建交易 类型 "expense" 金额 1500 到账户 "现金" 日期 "2026-02-01" 备注 "午餐"
    When 搜索 "午餐"
    Then 搜索命中 1 条 总数 1

  Scenario: 软删除交易从搜索结果中消失
    Given 存在账户 "现金" 类型 "cash" 币种 "CNY"
    When 创建交易 类型 "expense" 金额 1500 到账户 "现金" 日期 "2026-02-01" 备注 "午餐"
    And 创建交易 类型 "expense" 金额 300 到账户 "现金" 日期 "2026-02-02" 备注 "晚餐"
    When 删除备注为 "午餐" 的交易
    When 搜索 "午餐"
    Then 搜索命中 0 条
    When 搜索 "晚餐"
    Then 搜索命中 1 条

  Scenario: 多关键字组合要求同时命中
    Given 存在账户 "现金" 类型 "cash" 币种 "CNY"
    When 创建交易 类型 "expense" 金额 1500 到账户 "现金" 日期 "2026-02-01" 备注 "午餐"
    And 创建交易 类型 "expense" 金额 300 到账户 "现金" 日期 "2026-02-02" 备注 "晚餐"
    When 搜索 "午餐 现金"
    Then 搜索命中 1 条 总数 1
    When 搜索 "午餐 晚餐"
    Then 搜索命中 0 条

  Scenario: 黑洞账户交易可搜（口径与列表一致）
    When 创建交易 类型 "income" 金额 700 到账户 "无(CNY)" 日期 "2026-02-01" 备注 "退款入账"
    When 搜索 "退款"
    Then 搜索命中 1 条 总数 1

  Scenario: 覆盖全部交易类型
    Given 存在账户 "现金" 类型 "cash" 币种 "CNY"
    And 存在账户 "银行" 类型 "bank" 币种 "CNY"
    When 创建交易 类型 "income" 金额 5000 到账户 "现金" 日期 "2026-02-01" 备注 "工资"
    And 创建交易 类型 "expense" 金额 1500 到账户 "现金" 日期 "2026-02-02" 备注 "午餐"
    And 关联上一笔交易创建退款 金额 200 日期 "2026-02-04"
    And 创建转账 金额 3000 从 "现金" 到 "银行" 日期 "2026-02-03"
    When 搜索 "现金"
    Then 搜索命中 4 条 总数 4
    When 搜索 "银行"
    Then 搜索命中 0 条 总数 0

  Scenario: 分页与命中总数
    Given 存在账户 "现金" 类型 "cash" 币种 "CNY"
    When 创建交易 类型 "expense" 金额 100 到账户 "现金" 日期 "2026-01-01" 备注 "午餐"
    And 创建交易 类型 "expense" 金额 200 到账户 "现金" 日期 "2026-01-02" 备注 "午餐"
    And 创建交易 类型 "expense" 金额 300 到账户 "现金" 日期 "2026-01-03" 备注 "午餐"
    And 创建交易 类型 "expense" 金额 400 到账户 "现金" 日期 "2026-01-04" 备注 "午餐"
    And 创建交易 类型 "expense" 金额 500 到账户 "现金" 日期 "2026-01-05" 备注 "午餐"
    When 搜索 "午餐" 第 1 页 每页 2 条
    Then 搜索命中 2 条 总数 5
    And 搜索结果第 1 条金额应为 500
    When 搜索 "午餐" 第 3 页 每页 2 条
    Then 搜索命中 1 条 总数 5
    And 搜索结果第 1 条金额应为 100

  Scenario: 空查询返回空结果
    Given 存在账户 "现金" 类型 "cash" 币种 "CNY"
    When 创建交易 类型 "income" 金额 1000 到账户 "现金" 日期 "2026-02-01" 备注 "午餐"
    When 搜索 ""
    Then 搜索命中 0 条 总数 0

  Scenario: FTS5 特殊字符不报错
    Given 存在账户 "现金" 类型 "cash" 币种 "CNY"
    When 创建交易 类型 "income" 金额 1000 到账户 "现金" 日期 "2026-02-01" 备注 "午餐"
    When 搜索 "午餐 AND 现金 OR (NOT)"
    Then 搜索命中 0 条

  Scenario: 金额区间筛选含边界
    Given 存在账户 "现金" 类型 "cash" 币种 "CNY"
    And 存量交易 备注 "早餐" 金额 1000 账户 "现金" 日期 "2026-02-01"
    And 存量交易 备注 "午餐" 金额 1550 账户 "现金" 日期 "2026-02-02"
    And 存量交易 备注 "晚餐" 金额 2000 账户 "现金" 日期 "2026-02-03"
    When 重建搜索索引
    When 搜索金额区间 1550 至 2000 分
    Then 搜索命中 2 条 总数 2
    And 搜索结果第 1 条金额应为 2000
    And 搜索结果第 2 条金额应为 1550

  Scenario: 金额单边筛选（只填下限或上限）
    Given 存在账户 "现金" 类型 "cash" 币种 "CNY"
    And 存量交易 备注 "早餐" 金额 1000 账户 "现金" 日期 "2026-02-01"
    And 存量交易 备注 "午餐" 金额 1500 账户 "现金" 日期 "2026-02-02"
    And 存量交易 备注 "晚餐" 金额 2000 账户 "现金" 日期 "2026-02-03"
    When 重建搜索索引
    When 搜索金额下限 1500 分
    Then 搜索命中 2 条 总数 2
    When 搜索金额上限 1500 分
    Then 搜索命中 2 条 总数 2

  Scenario: 金额筛选元转分（15.5 元 → 1550 分）
    Given 存在账户 "现金" 类型 "cash" 币种 "CNY"
    And 存量交易 备注 "午餐" 金额 1550 账户 "现金" 日期 "2026-02-02"
    And 存量交易 备注 "晚餐" 金额 3000 账户 "现金" 日期 "2026-02-03"
    When 重建搜索索引
    When 搜索金额区间 15.5 至 20 元
    Then 搜索命中 1 条 总数 1
    And 搜索结果第 1 条金额应为 1550

  Scenario: 日期区间筛选含边界
    Given 存在账户 "现金" 类型 "cash" 币种 "CNY"
    And 存量交易 备注 "早餐" 金额 1000 账户 "现金" 日期 "2026-02-01"
    And 存量交易 备注 "午餐" 金额 1000 账户 "现金" 日期 "2026-02-05"
    And 存量交易 备注 "晚餐" 金额 1000 账户 "现金" 日期 "2026-02-10"
    When 重建搜索索引
    When 搜索日期区间 "2026-02-01" 至 "2026-02-05"
    Then 搜索命中 2 条 总数 2
    And 搜索结果第 1 条备注应为 "午餐"
    And 搜索结果第 2 条备注应为 "早餐"

  Scenario: 金额与日期筛选和关键字 AND 组合
    Given 存在账户 "现金" 类型 "cash" 币种 "CNY"
    And 存量交易 备注 "午餐" 金额 1550 账户 "现金" 日期 "2026-02-02"
    And 存量交易 备注 "午餐" 金额 3000 账户 "现金" 日期 "2026-02-03"
    And 存量交易 备注 "午餐" 金额 3000 账户 "现金" 日期 "2026-02-10"
    And 存量交易 备注 "晚餐" 金额 1550 账户 "现金" 日期 "2026-02-04"
    When 重建搜索索引
    When 搜索 "午餐" 金额区间 1500 至 2000 分
    Then 搜索命中 1 条 总数 1
    And 搜索结果第 1 条金额应为 1550
    When 搜索 "午餐" 日期区间 "2026-02-01" 至 "2026-02-05"
    Then 搜索命中 2 条 总数 2

  Scenario: 无关键字仅金额筛选可出结果
    Given 存在账户 "现金" 类型 "cash" 币种 "CNY"
    When 创建交易 类型 "expense" 金额 1500 到账户 "现金" 日期 "2026-02-01" 备注 "午餐"
    And 创建交易 类型 "expense" 金额 300 到账户 "现金" 日期 "2026-02-02" 备注 "晚餐"
    When 搜索金额区间 1000 至 2000 分
    Then 搜索命中 1 条 总数 1
    And 搜索结果第 1 条备注应为 "午餐"
    And 搜索结果第 1 条金额应为 1500
