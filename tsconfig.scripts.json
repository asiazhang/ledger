{
  /* 守门脚本与测试的类型检查工程（issue #734 / ADR-0083）。原 extends 根
     tsconfig.base.json 随 Web 参照前端退役删除（#2171/#2172），公共项就地内联
     （原继承值逐字保留，仅删去前端专属项：lib 的 DOM 面、paths 的 @/* 映射——
     两者的唯一消费者是已删除的前端工程）。类型检查执行 = bunx 拉取 typescript 7
     原生 tsc（vue-tsc 随前端退役，其存在的唯一理由 vue 单文件组件不复存在）：
     bunx --package typescript@7.0.2 --package bun-types@1.4.0 --package @types/node@22.20.1 \
       tsc --noEmit -p tsconfig.scripts.json（版本钉死，与 CI 同值）。
     include 面自前端退役后只剩 scripts/（原 src/**、packages/** 测试面已删除）。 */
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "types": ["node", "bun-types"]
  },
  "include": ["scripts/**/*.ts"]
}
